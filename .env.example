# ─────────────────────────────────────────────────────────────
#  Aéris — variables d'environnement
#  Copiez ce fichier en `.env.local` (développement) ou déclarez
#  ces variables chez votre hébergeur (Vercel → Settings → Env).
#  AUCUNE de ces valeurs secrètes n'est envoyée au navigateur :
#  seules les variables préfixées NEXT_PUBLIC_ le sont.
# ─────────────────────────────────────────────────────────────

# URL publique du site (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.exemple-aeris.be

# Afficher les emplacements « À compléter » (avis, photos, coordonnées…)
# true pendant la mise en place, false avant la mise en ligne publique.
NEXT_PUBLIC_SHOW_PLACEHOLDERS=true

# ── Envoi des formulaires (commande, devis, contact) ─────────
# log       : n'envoie rien, écrit dans la console serveur (défaut en dev)
# formspree : transfère vers Formspree (défaut en production)
MAIL_TRANSPORT=log
FORMSPREE_ORDER_ID=xykqgqyj
FORMSPREE_CONTACT_ID=mgojwjvp
# Optionnel : webhook CRM (Zapier, Make, HubSpot…) qui reçoit aussi chaque demande
CRM_WEBHOOK_URL=

# ── Assistant IA ─────────────────────────────────────────────
# Sans clé : l'assistant répond à partir de la base de connaissances locale.
# Avec une clé : réponses rédigées par un LLM, toujours limitées aux faits du site.
AI_PROVIDER=anthropic          # anthropic | openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=
OPENAI_MODEL=

# ── Mesure d'audience (chargée uniquement après consentement) ─
NEXT_PUBLIC_GA_ID=
